// ===== GAME STATE =====
int player_1_score = 0;
bool game_over = false;

struct Player{
  int health;
  int x;
  int y;
};

Player player_1;

//Forward declration
void draw_walking(uint8_t frame);
void draw_game();

void setup() {
  // put your setup code here, to run once:
  u8g2.begin();

  player_1.x = 30;
}

void loop() {
  draw_game();
}

void draw_player_1_walking(uint8_t frame){
  switch (frame) {
    case 0:
    break;
    case 1:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-24, 13, 24, player_walking_passing_pose_bits);
    break;
    case 2:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-23, 16, 23, player_walking_right_foot_contact_pose_bits);
    break;
  }
}

void draw_player_1_punching(uint8_t frame){
  switch (frame) {
    case 0:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-21, 12, 21 , idk4_bits);
    break;
    case 1:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-24, 12, 24 , idk3_bits);
    break;
    case 2:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-24, 13, 24, player_walking_passing_pose_bits);
    break;
    case 3:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-22, 16, 22, idk4_bits);
    break;
    case 4: 
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-19, 16, 19, front_punch_frame_4_bits);
    break;
    case 5:
      u8g2.drawXBMP(player_1.x, SCREEN_HEIGHT-24, 13, 24, player_walking_passing_pose_bits);
    break;
  }
}

void draw_game(){
  u8g2.firstPage();

  do {
    //u8g2.drawXBMP(30, SCREEN_HEIGHT-23, 16, 23, idk_2_bits);
    //draw_player_1_walking(1);
    //draw_player_1_walking(2);
    draw_player_1_punching(3);
  }while (u8g2.nextPage());

}


